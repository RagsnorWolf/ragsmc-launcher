{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RagsMC-Launcher",
  "version": "2.0.0",
  "identifier": "com.ragsnorwolf.ragsmc-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RagsMC Launcher",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maxWidth": 3840,
        "maxHeight": 2160,
        "resizable": true,
        "maximizable": true,
        "maximized": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "backgroundColor": "#0a0e0d",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}