{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RagsMC-Launcher",
  "version": "1.0.2",
  "identifier": "com.ragsnorwolf.ragsmc-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RagsMC Launcher",
        "width": 1120,
        "height": 700,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "backgroundColor": "#0a0e0d",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {}
  }
}
